pipeline {
  agent { label 'terraform' }
  options {
    timestamps()
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '20'))
    timeout(time: 60, unit: 'MINUTES')
  }
  parameters {
    choice(name: 'ACTION', choices: ['plan', 'apply', 'destroy'], description: 'Terragrunt action')
    choice(name: 'ENVIRONMENT', choices: ['dev', 'prod'], description: 'Live environment directory')
  }
  stages {
    stage('Checkout') {
      steps { cleanWs(); checkout scm }
    }
    stage('Format and validate') {
      steps {
        sh 'terraform fmt -check -recursive infrastructure/terraform'
        sh 'terragrunt --version'
      }
    }
    stage('Plan') {
      steps {
        withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'demo-terraform-role']]) {
          dir("infrastructure/terragrunt/live/${params.ENVIRONMENT}/web") { sh 'terragrunt run --all plan --non-interactive' }
        }
      }
    }
    stage('Production approval') {
      when { expression { params.ENVIRONMENT == 'prod' && params.ACTION != 'plan' } }
      steps { input message: "Approve ${params.ACTION} for the reviewed production plan?", ok: 'Approve change' }
    }
    stage('Apply or destroy') {
      when { expression { params.ACTION != 'plan' } }
      steps {
        withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'demo-terraform-role']]) {
          dir("infrastructure/terragrunt/live/${params.ENVIRONMENT}/web") {
            sh "terragrunt run --all ${params.ACTION} --non-interactive"
          }
        }
      }
    }
  }
  post { always { cleanWs() } }
}
